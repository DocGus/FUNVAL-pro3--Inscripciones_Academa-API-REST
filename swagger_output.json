    "/api/estudiantes/": {
      "get": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Obtener estudiantes",
        "description": "Devuelve todos los estudiantes registrados. Permite filtrar por nombre de bootcamp.",
        "parameters": [
          {
            "name": "bootcamp",
            "in": "query",
            "description": "Nombre del bootcamp para filtrar",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
