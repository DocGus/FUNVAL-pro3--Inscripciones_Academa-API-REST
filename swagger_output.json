        ],
        "summary": "Registrar estudiante",
        "description": "Registra un nuevo estudiante.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos del estudiante",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Juan Pérez"
                },
                "email": {
                  "type": "string",
                  "example": "juan@example.com"
