
{
  "compilerOptions": {
    // Organización de archivos
    "rootDir": "./src",
    "outDir": "./dist",

    // Configuración de Node.js y módulos
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "types": ["node"],
    "ignoreDeprecations": "6.0",

    // Archivos generados
    "sourceMap": true,

    // Validaciones de TypeScript
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Compatibilidad con Express
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,

    // Generar JavaScript en dist
    "noEmit": false
  },
  "include": ["src"]
}
